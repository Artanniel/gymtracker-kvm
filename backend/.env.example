# ==========================================
# GYMTRACKER - VARIAVEIS DE AMBIENTE (RAILWAY)
# ==========================================

# --- PostgreSQL (mesmo banco do InvoiceBuilder) ---
# O Gymtracker usa schema separado 'gymtracker' no mesmo banco
DATABASE_URL=postgresql://postgres:sua_senha_aqui@host_do_railway:5432/invoicepro

# --- Keycloak (mesma instancia do InvoiceBuilder) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_super_secreto
# URL publica do Keycloak (usar a mesma instancia do InvoiceBuilder)
KC_HOSTNAME=https://keyclock.up.railway.app
KC_PROXY=edge
KC_DB=postgres
KC_DB_URL=${DATABASE_URL}
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=sua_senha_aqui

# --- Quarkus Backend ---
# URL publica do backend para CORS
QUARKUS_HTTP_CORS_ORIGINS=https://gymtracker-frontend-dev.up.railway.app
# URL do Keycloak para validacao de tokens
QUARKUS_OIDC_AUTH_SERVER_URL=${KC_HOSTNAME}/realms/gymtracker
QUARKUS_OIDC_CLIENT_ID=gymtracker-backend
QUARKUS_OIDC_CREDENTIALS_SECRET=sua_senha_secreta_backend
# Conexao com o banco (schema gymtracker)
QUARKUS_DATASOURCE_JDBC_URL=jdbc:${DATABASE_URL}
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=sua_senha_aqui

# --- Schema (separado do InvoiceBuilder) ---
QUARKUS_HIBERNATE ORM_DATABASE_DEFAULT_SCHEMA=gymtracker
QUARKUS_LIQUIBASE_DEFAULT_SCHEMA_NAME=gymtracker
