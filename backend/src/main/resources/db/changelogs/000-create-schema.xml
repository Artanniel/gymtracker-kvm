<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Create gymtracker schema -->
    <changeSet id="000-create-schema" author="gymtracker">
        <sql>CREATE SCHEMA IF NOT EXISTS gymtracker</sql>
        <sql>GRANT ALL ON SCHEMA gymtracker TO postgres</sql>
        <sql>SET search_path TO gymtracker</sql>
    </changeSet>

</databaseChangeLog>
