<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-workout-sessions" author="gymtracker">
        <createTable tableName="workout_sessions">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="workout_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="workout_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="workout_sessions" indexName="idx_sessions_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="workout_sessions" indexName="idx_sessions_date">
            <column name="date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
