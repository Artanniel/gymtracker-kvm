<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-workout-configs" author="gymtracker">
        <createTable tableName="workout_configs">
            <column name="workout_id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BIGINT" defaultValueNumeric="0"/>
            <column name="start_date" type="BIGINT"/>
            <column name="end_date" type="BIGINT"/>
            <column name="is_archived" type="BIGINT" defaultValueNumeric="0"/>
            <column name="cover_image" type="VARCHAR(500)"/>
            <column name="youtube_url" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="workout_configs" indexName="idx_configs_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
